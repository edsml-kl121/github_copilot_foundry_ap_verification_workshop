# --- Microsoft Foundry credentials ----------------------------------
# Copy this file to ".env" and fill in the values (see workshop_guideline/01_setup_lab.md).
#
#   cp .env.template .env
#
# Never commit .env. It is already listed in .gitignore.
# --------------------------------------------------------------------

# Azure OpenAI endpoint of your Foundry resource (Foundry portal > Overview > "Azure OpenAI" endpoint).
# Format: https://<resource-name>.openai.azure.com/
FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com/

# Foundry resource API key (Key 1 or Key 2). Also used for Document Intelligence (OCR).
FOUNDRY_API_KEY=replace-with-your-api-key

# Foundry project endpoint (used by the portal lab and the Agent Framework lab).
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Model deployment names (must match Build > Models / Deployments in your project).
FOUNDRY_DEPLOYMENT_CHAT=gpt-4.1-mini
FOUNDRY_DEPLOYMENT_VISION=gpt-4.1

# Optional. Document Intelligence endpoint. Leave as-is to derive it from FOUNDRY_ENDPOINT:
#   https://<resource-name>.cognitiveservices.azure.com/
FOUNDRY_DOCINTEL_ENDPOINT=

# Microsoft Web IQ API key (https://webiq.microsoft.ai/profiles). Needed for example 5 only.
WEBIQ_API_KEY=replace-with-your-webiq-key

# Optional. Reuse a policy vector store created with: python python_examples/03_vector_search.py --keep
AP_POLICY_VECTOR_STORE_ID=

# "Today" for the lab data, so answers like "overdue invoices" are repeatable.
AP_AS_OF_DATE=2026-11-24
